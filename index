/** Cantidades de personas, dentro de la capacidad, que ningún tramo activo cubre. */
function huecosTramos(c) {
  const lista = tarifasDeCab(c.ID).filter(t => t.Activa);
  if (!lista.length) return [];
  const faltan = [];
  for (let g = 1; g <= c.Capacidad; g++) {
    if (!lista.some(t => g >= t.MinPersonas && g <= (t.MaxPersonas || t.MinPersonas))) faltan.push(g);
  }
  if (!faltan.length) return [];
  // Agrupa 1,2,3 -> "1 a 3"
  const grupos = [];
  faltan.forEach(n => {
    const g = grupos[grupos.length - 1];
    if (g && n === g[g.length - 1] + 1) g.push(n); else grupos.push([n]);
  });
  return grupos.map(g => g.length === 1 ? `${g[0]} persona${g[0] === 1 ? '' : 's'}` : `${g[0]} a ${g[g.length - 1]} personas`);
}

