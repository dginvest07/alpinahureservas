  try {
    const s = await call('adminLogin', f.user, f.pass);
    S.ad.token = s.token;
    S.ad.user = s;
    S.ad.panel = s.panel;
    store.set('adm_tk', s.token);
    store.set('adm_user', JSON.stringify(s));
    closeModal();
    if (s.panel === 'limpieza') await loadStaff();
    else await loadAdmin();
  } catch (e) {
    err.textContent = e.message;
  } finally {
    busy(false);
  }
}

async function loadStaff() {
  S.view = 'staff';
  if (!S.st) { renderAppbar(); $('#view').innerHTML = loadingView('Cargando agenda…'); }
  const hoy = (S.data && S.data.hoy) || '';
  const rangos = { hoy: [hoy, 1], manana: [hoy ? D.add(hoy, 1) : '', 1], 7: [hoy, 7], 14: [hoy, 14] };
  const [desde, dias] = rangos[S.stRange] || rangos[7];
  const r = await adminCall('staffAgenda', desde, dias);
  if (r) { S.st = r; render(); window.scrollTo(0, 0); }
}

async function loadAdmin() {
  if (S.ad.panel === 'limpieza') return loadStaff();
  S.view = 'admin';
  if (!S.ad.d) { renderAppbar(); $('#view').innerHTML = loadingView('Cargando panel…'); }
  const d = await adminCall('adminGetDashboard');
  if (d) {
    S.ad.d = d;
    const tabs = adminTabsDisponibles(d);
    if (!tabs.some(t => t[0] === S.ad.tab)) S.ad.tab = tabs[0][0];
    render(); window.scrollTo(0, 0);
    if (S.ad.tab === 'finanzas') await loadFinance();
  }
}

function endSession(msg) {
  S.ad.token = null; S.ad.user = null; S.ad.d = null; S.ad.fin = null; S.ad.panel = null; S.st = null;
  store.set('adm_tk', null); store.set('adm_user', null);
  S.view = 'home';
  render();
  if (msg) toast(msg);
}

async function adminCall(fn, ...args) {
  busy(true);
  try {
    const res = await call(fn, S.ad.token, ...args);
    if (res && res.stats) S.ad.d = res;
    return res;
  } catch (e) {
    if (/SESION_EXPIRADA/.test(e.message)) {
      endSession('Tu sesión venció. Ingresá de nuevo.');
      openLogin();
    } else {
      toast(e.message);
    }
    return null;
  } finally {
    busy(false);
  }
}

