function tierLine() {
  const c = cab(), b = S.bk;
  if (!c || !(c.Tarifas || []).length) return '';
  const modo = tipo().Modo;
  const gTarifa = huespedesParaTarifa(modo, b.g);
  const t = tarifaPara(c, gTarifa);
  if (!t) {
    return `<div class="tier-line bad">${ic('info', 16)} Para ${plural(b.g, 'huésped', 'huéspedes')} no hay tarifa cargada. Escribinos y la armamos a medida.</div>`;
  }
  const rango = t.MinPersonas === (t.MaxPersonas || t.MinPersonas)
    ? plural(t.MinPersonas, 'persona', 'personas') : `${t.MinPersonas} a ${t.MaxPersonas} personas`;
  return `<div class="tier-line">${ic('tag', 16)}<b>${esc(t.Nombre || rango)}</b>
    <span class="muted">${esc(txtSemana())}: <b>${money(precioNoche(t, c, gTarifa, false, false))}</b> por noche</span>
    <span class="muted">${esc(txtFinde())}: <b>${money(precioNoche(t, c, gTarifa, true, false))}</b> por noche</span>
    ${modo === 'DIA' && b.g === 1 ? '<span class="muted small">1 persona: se aplica la tarifa de pareja.</span>' : ''}
    ${t.PrecioPaquete > 0 ? `<span class="pill-paq">${ic('zap', 13)} Paquete desde ${t.PaqueteMinNoches || 2} noches entre semana: ${money(precioNoche(t, c, gTarifa, false, true))} por noche</span>` : ''}</div>`;
}

function summaryBox(est) {
  const t = tipo(), cfg = S.data.config;
  if (!est) return `<div class="summary mt16"><p class="muted">${t.Modo === 'DIA' ? 'Elegí el día' : 'Elegí llegada y salida'} para ver el precio.</p></div>`;
  if (est.sinTarifa) return `<div class="summary mt16"><p class="err">${esc(est.errors[0])}</p></div>`;
  const d = est.detalle;
  const veces = est.occ.length > 1 ? ` × ${est.occ.length} estadías` : '';
  const lineas = [];
  if (est.modo === 'DIA') {
    lineas.push([`Deep Work Day · ${plural(est.g, 'persona', 'personas')}`, money(d.deepWork * est.occ.length)]);
  } else {
    if (d.nochesPaquete) lineas.push([`Paquete entre semana · ${plural(d.nochesPaquete, 'noche', 'noches')} × ${money(d.precioPaquete)}`, money(d.nochesPaquete * d.precioPaquete)]);
    if (d.nochesSemana) lineas.push([`${plural(d.nochesSemana, 'noche', 'noches')} ${txtSemana().toLowerCase()} × ${money(d.precioSemana)}`, money(d.nochesSemana * d.precioSemana)]);
    if (d.nochesFinde) lineas.push([`${plural(d.nochesFinde, 'noche', 'noches')} ${txtFinde().toLowerCase()} × ${money(d.precioFinde)}`, money(d.nochesFinde * d.precioFinde)]);
  }
  const tar = est.tarifa;
  return `<div class="summary mt16">
    ${tar ? `<div class="head"><b>${esc(tar.Nombre || plural(est.g, 'persona', 'personas'))}</b><span class="muted small">${plural(est.g, 'huésped', 'huéspedes')}</span></div>` : ''}
    ${est.modo === 'DIA' && est.g === 1 ? '<p class="muted small" style="margin:2px 0 8px">1 persona: se aplica la tarifa de pareja.</p>' : ''}
    ${est.paquete ? `<p class="pill-paq" style="margin:2px 0 8px">${ic('zap', 13)} Paquete entre semana aplicado</p>` : ''}
    ${lineas.map(l => `<div class="line"><span>${l[0]}${veces && est.modo !== 'DIA' ? '' : ''}</span><b>${l[1]}</b></div>`).join('')}
    ${est.occ.length > 1 ? `<div class="line"><span class="small">Incluye las ${est.occ.length} estadías programadas</span></div>` : ''}
    ${est.tipoPct ? `<div class="line disc"><span>${esc(t.Nombre)} (-${est.tipoPct}%)</span><b>-${money(est.subtotal * est.tipoPct / 100)}</b></div>` : ''}
    ${est.promoPct ? `<div class="line disc"><span>Código ${esc(S.bk.promo)} (-${est.promoPct}%)</span><b>-${money(est.subtotal * est.promoPct / 100)}</b></div>` : ''}
