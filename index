  const lista = filtro ? cabs.filter(c => c.ID === filtro) : cabs;
  return `<div class="a-head">
      <div><h1>Tarifas por cantidad de personas</h1>
      <p class="muted">Cada tramo define el precio por noche según cuántos huéspedes vienen. ${esc(txtSemana())} es tarifa de semana; ${esc(txtFinde().toLowerCase())} es tarifa alta.</p></div>
      <div class="a-actions">
        <select class="input" style="height:40px;width:auto" data-in="ad.tarCab" data-rr aria-label="Filtrar por cabaña">
          <option value="">Todas las cabañas</option>
