function pickDay(iso) {
  const b = S.bk, t = tipo(), hoy = S.data.hoy;
  const occ = S.occ[S.cabId] || new Set();
  if (iso < hoy) return;
  if (t.Modo === 'DIA') {
     if (D.dow(iso) < 1 || D.dow(iso) > 4) {
      return toast('Deep Work Day está disponible únicamente de lunes a jueves.');
    }
    if (occ.has(iso)) return toast('Ese día la cabaña está ocupada.');
    b.ci = iso; b.co = iso;
  } else if (t.Modo === 'FINDE') {
    if (D.dow(iso) !== 5) return toast('El paquete fin de semana empieza un viernes.');
    if (!isFree(S.cabId, iso, D.add(iso, 2))) return toast('Ese fin de semana ya está ocupado.');
    b.ci = iso; b.co = D.add(iso, 2);
  } else if (!b.ci || b.co || iso <= b.ci) {
    if (occ.has(iso)) return toast('Ese día la cabaña está ocupada.');
    b.ci = iso; b.co = '';
  } else {
    if (!isFree(S.cabId, b.ci, iso)) {
      toast('Hay noches ocupadas en ese rango. Elegí otra salida.');
      return;
    }
    b.co = iso;
  }
  rerender();
}

