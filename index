/** Muestra cuánto paga cada cantidad de personas del tramo, con el mismo cálculo del servidor. */
function tarifaPreview() {
  const box = $('#tarPrev');
  if (!box) return;
  const f = formData($('#tarForm'));
  const c = S.ad.d.cabanas.find(x => x.ID === f.CabanaID) || S.ad.d.cabanas[0];
  const min = Math.max(Number(f.MinPersonas) || 1, 1);
  const max = Math.max(Number(f.MaxPersonas) || min, min);
  const t = {
    TipoPrecio: f.TipoPrecio, PrecioSemana: Number(f.PrecioSemana) || 0, PrecioFinSemana: Number(f.PrecioFinSemana) || Number(f.PrecioSemana) || 0,
    TipoPaquete: f.TipoPaquete, PrecioPaquete: Number(f.PrecioPaquete) || 0, PaqueteMinNoches: Number(f.PaqueteMinNoches) || 2,
    MinPersonas: min, MaxPersonas: max
  };
  if (!t.PrecioSemana) { box.innerHTML = '<span class="muted">Cargá el precio de semana para ver el ejemplo.</span>'; return; }
  const avisos = [];
  if (max > c.Capacidad) avisos.push(`<span class="err">${esc(c.Nombre)} admite hasta ${c.Capacidad} huéspedes.</span>`);
  const muestras = [];
  for (let g = min; g <= max && muestras.length < 4; g++) muestras.push(g);
  if (!muestras.includes(max)) muestras[muestras.length - 1] = max;
  const filas = muestras.map(g => `<div><span>${plural(g, 'persona', 'personas')}</span><b>${money(precioNoche(t, c, g, false, false))} / ${money(precioNoche(t, c, g, true, false))}${t.PrecioPaquete ? ` / ${money(precioNoche(t, c, g, false, true))}` : ''}</b></div>`).join('');
  box.innerHTML = `<b>Por noche: ${esc(txtSemana().toLowerCase())} / ${esc(txtFinde().toLowerCase())}${t.PrecioPaquete ? ' / paquete' : ''}</b>
    <div class="prev-table mt8">${filas}</div>
    ${t.PrecioPaquete ? `<p class="small muted">Ejemplo: ${t.PaqueteMinNoches} noches corridas ${esc(txtSemana().toLowerCase())} con ${max} personas = <b>${money(precioNoche(t, c, max, false, true) * t.PaqueteMinNoches)}</b> en total.</p>` : ''}
    ${avisos.join(' ')}`;
}

