<!DOCTYPE html>
<html lang="es">
<head>
<base target="_top">
<meta charset="utf-8">

<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">

<!-- Experiencia tipo app en iPhone -->
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Alpina Hu">
<meta name="theme-color" content="#FF7A00">

<!-- Icono de la app -->
<link rel="apple-touch-icon" href="https://static.wixstatic.com/media/5ebdda_1b9522c852594a57b39aae412a05d833~mv2.png">
<link rel="apple-touch-icon" sizes="180x180" href="https://static.wixstatic.com/media/5ebdda_1b9522c852594a57b39aae412a05d833~mv2.png">
<link rel="icon" type="image/png" href="https://static.wixstatic.com/media/5ebdda_1b9522c852594a57b39aae412a05d833~mv2.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* ============ Tokens (del diseño JSON) ============ */
:root{
  --primary:#FF7A00; --primary-light:#FFE8D6; --primary-dark:#B85600;
  --bg:#FFFFFF; --surface:#F9F9F9; --text:#1A1A1A; --text2:#8E8E93;
  --divider:#E5E5EA; --star:#FFCC00; --inactive:#C7C7CC; --minus:#F0F0F0;
  --ok:#1E7A45; --ok-bg:#E3F5EA; --info:#2F5AA8; --info-bg:#E8EEF9; --danger:#D93F3F;
  --r-s:8px; --r-m:16px; --r-l:24px; --r-btn:12px; --r-card:20px;
  --pad:20px; --gap:16px;
  --shadow:0 10px 30px rgba(26,26,26,.08);
  --safe-b:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{font-family:Inter,"SF Pro Display",system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;min-height:100vh}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;text-align:inherit}
button:disabled{cursor:not-allowed;opacity:.45}
a{color:inherit;text-decoration:none}
input,select,textarea{font:inherit;color:inherit}
h1,h2,h3{line-height:1.2}
:focus-visible{outline:2px solid var(--primary);outline-offset:2px;border-radius:6px}
.ic{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;display:inline-block;vertical-align:middle}
.ic.fill{fill:currentColor}
.ic.star{color:var(--star);fill:var(--star);stroke:var(--star)}
.ic.star.off{color:var(--divider);fill:var(--divider);stroke:var(--divider)}
.muted{color:var(--text2)}
.small{font-size:12px}
.err{color:var(--danger)}
.ok{color:var(--ok)}
.mt8{margin-top:8px}.mt12{margin-top:12px}.mt16{margin-top:16px}.mt24{margin-top:24px}
.row{display:flex;align-items:center;gap:8px}
.row-between{display:flex;align-items:center;justify-content:space-between;gap:12px}
.full{width:100%}
.wrap{max-width:1180px;margin:0 auto;padding:0 var(--pad)}
.narrow{max-width:560px}
.clamp2{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.hscroll{display:flex;gap:12px;overflow-x:auto;padding-bottom:6px;scroll-snap-type:x mandatory;scrollbar-width:none;margin:0 calc(var(--pad)*-1);padding-left:var(--pad);padding-right:var(--pad)}
.hscroll::-webkit-scrollbar{display:none}
.hscroll>*{scroll-snap-align:start}

/* ============ Botones ============ */
.btn{height:52px;padding:0 20px;border-radius:var(--r-btn);font-size:16px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;white-space:nowrap;transition:background .15s,transform .1s}
.btn:active{transform:scale(.98)}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover{background:#F06F00}
.btn-outline{border:1.5px solid var(--primary);color:var(--primary);background:#fff}
.btn-soft{background:var(--primary-light);color:var(--primary-dark)}
.btn-ghost{color:var(--text2)}
.btn-danger{background:#FDECEC;color:var(--danger)}
.btn.sm{height:40px;font-size:14px;padding:0 14px;border-radius:10px}
.icon-btn{width:40px;height:40px;border-radius:12px;display:grid;place-items:center}
.icon-btn:hover{background:var(--surface)}
.round-btn{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.96);display:grid;place-items:center;box-shadow:0 4px 14px rgba(0,0,0,.14)}
.round-btn.liked{color:var(--primary)}
.link{color:var(--primary);font-weight:600}

/* ============ Barra superior ============ */
.appbar{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.94);backdrop-filter:saturate(180%) blur(12px);-webkit-backdrop-filter:saturate(180%) blur(12px);border-bottom:1px solid var(--divider)}
.appbar .wrap{display:flex;align-items:center;gap:8px;height:64px}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:16px;min-width:0}
.brand span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brand-mark{width:36px;height:36px;border-radius:11px;background:var(--primary);color:#fff;display:grid;place-items:center;flex-shrink:0}
.brand-mark.img{background-color:#fff;background-position:center;background-size:cover;background-repeat:no-repeat;border:1px solid var(--divider)}
.logo-row{display:flex;gap:16px;align-items:flex-start}
.logo-prev{padding-top:22px;flex-shrink:0}
.logo-prev .brand-mark{border-radius:16px}
.logo-fields{flex:1;min-width:0}
.nav{display:none;gap:4px;margin-left:20px}
.nav button{padding:8px 14px;border-radius:10px;color:var(--text2);font-weight:500}
.nav button.on{color:var(--primary);background:var(--primary-light)}
.spacer{flex:1}
.bar-btn{height:40px;padding:0 12px;border-radius:12px;border:1px solid var(--divider);display:inline-flex;align-items:center;gap:8px;font-weight:600;white-space:nowrap}
.bar-btn .t{display:none}
.m-only{display:grid}
@media(min-width:768px){.nav{display:flex}.bar-btn .t{display:inline}.m-only{display:none}}

/* ============ Encabezado de pantalla (top_bar) ============ */
.topbar{display:grid;grid-template-columns:40px 1fr 40px;align-items:center;gap:8px;padding:12px 0}
.topbar h1{font-size:20px;font-weight:700;text-align:center}
.tb-title{text-align:center;min-width:0}
.tb-title h1{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tb-title small{display:block;color:var(--text2);font-size:12px;margin-top:2px}
@media(min-width:1024px){.topbar h1{font-size:24px}}
.section-h{display:flex;align-items:center;gap:8px;font-size:18px;font-weight:600;margin:28px 0 12px}
.section-h .ic{color:var(--primary)}
#cabanas{scroll-margin-top:84px}
.section-h small{font-size:13px;font-weight:500;color:var(--text2);margin-left:auto}

/* ============ Inicio ============ */
.home-hero{position:relative;min-height:440px;display:flex;align-items:flex-end;background:#3a2a1c center/cover no-repeat;border-radius:0 0 28px 28px;overflow:hidden}
.home-hero::before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.05) 20%,rgba(0,0,0,.62) 100%)}
.hero-in{position:relative;color:#fff;padding-bottom:92px;width:100%}
.hero-in h1{font-size:clamp(34px,7vw,64px);font-weight:800;letter-spacing:-.03em;line-height:1.02;max-width:12ch}
.hero-in p{font-size:16px;margin-top:12px;max-width:42ch;color:rgba(255,255,255,.88)}
@media(min-width:1024px){.home-hero{min-height:520px;border-radius:0 0 36px 36px}}
.search-card{position:relative;margin-top:-60px;background:#fff;border-radius:var(--r-card);box-shadow:var(--shadow);padding:16px;display:grid;gap:12px;z-index:2}
.sf{display:flex;flex-direction:column;gap:6px;background:var(--surface);border-radius:14px;padding:10px 14px}
.sf>span{font-size:12px;color:var(--text2);font-weight:500}
.sf input{border:0;background:transparent;font-size:15px;font-weight:600;outline:none;width:100%;min-height:26px}
@media(min-width:768px){.search-card{grid-template-columns:1fr 1fr auto;align-items:stretch}.search-card .btn{height:auto}}
.promo{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:var(--r-m);background:var(--primary-light);min-width:270px;flex:0 0 auto}
.promo .pct{font-size:22px;font-weight:800;color:var(--primary);min-width:56px}
.promo b{display:block;font-size:14px}
.code-chip{display:inline-block;margin-top:4px;padding:2px 8px;border:1.5px dashed var(--primary);border-radius:6px;font-weight:700;font-size:12px;color:var(--primary-dark);letter-spacing:.04em}
.type-card{flex:0 0 220px;padding:16px;border-radius:var(--r-m);background:var(--surface);display:flex;flex-direction:column;gap:8px}
.type-card .ico{width:40px;height:40px;border-radius:12px;background:var(--primary-light);color:var(--primary);display:grid;place-items:center}
.type-card b{font-size:15px}
.tag{display:inline-block;padding:2px 8px;border-radius:999px;background:var(--primary);color:#fff;font-size:11px;font-weight:700}
.cab-grid{display:grid;gap:var(--gap);grid-template-columns:1fr}
@media(min-width:640px){.cab-grid{grid-template-columns:repeat(2,1fr)}}
@media(min-width:1024px){.cab-grid{grid-template-columns:repeat(3,1fr)}}
.cab-card{border-radius:var(--r-card);overflow:hidden;border:1px solid var(--divider);background:#fff;display:flex;flex-direction:column;text-align:left;transition:border-color .15s}
.cab-card:hover{border-color:var(--inactive)}
.cab-img{aspect-ratio:4/3;background:var(--primary-light) center/cover no-repeat;position:relative}
.cab-badge{position:absolute;top:12px;left:12px;background:#fff;border-radius:999px;padding:5px 11px;font-size:12px;font-weight:600}
.cab-badge.free{color:var(--ok)}
.cab-badge.busy{color:var(--danger)}
.cab-body{padding:16px;display:flex;flex-direction:column;gap:6px;flex:1}
.cab-body h3{font-size:17px;font-weight:700}
.rate{display:inline-flex;align-items:center;gap:4px;font-weight:600;font-size:13px}
.price{color:var(--primary);font-weight:700;font-size:16px}
.price small{color:var(--text2);font-weight:400;font-size:12px}
.facts{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
.fact{display:inline-flex;align-items:center;gap:6px;color:var(--text2);font-size:13px}
.fact .ic{width:16px;height:16px}
.footer{margin:48px 0 0;padding:28px 0 40px;border-top:1px solid var(--divider);display:grid;gap:16px}
@media(min-width:768px){.footer{grid-template-columns:1fr auto;align-items:center}}

/* ============ Detalle (screen_2) ============ */
.detail{display:block}
.d-media{height:40vh;min-height:260px;background:var(--primary-light) center/cover no-repeat;position:relative}
.d-media .ov{position:absolute;top:16px;left:var(--pad);right:var(--pad);display:flex;justify-content:space-between}
.d-sheet{position:relative;margin-top:-24px;background:#fff;border-radius:var(--r-l) var(--r-l) 0 0;padding:24px var(--pad) 0}
.title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.rest-title{font-size:22px;font-weight:700;color:var(--primary)}
.rest-title.sm{font-size:18px}
.nav-btn{width:44px;height:44px;border-radius:50%;background:var(--primary);color:#fff;display:grid;place-items:center;flex-shrink:0}
.meta-row{display:flex;align-items:center;gap:6px;color:var(--text2);margin-top:8px;flex-wrap:wrap}
.meta-row b{color:var(--text)}
.stars{display:inline-flex;gap:2px}
.tabs{display:flex;border-bottom:1px solid var(--divider);margin:20px 0 16px}
.tabs button{flex:1;padding:12px 0;font-weight:600;color:var(--text2);position:relative;text-align:center}
.tabs button.on{color:var(--text)}
.tabs button.on::after{content:"";position:absolute;left:30%;right:30%;bottom:-1px;height:3px;border-radius:3px;background:var(--primary)}
.body-text{color:var(--text2);line-height:1.5;max-width:68ch}
.amen{display:flex;flex-wrap:wrap;gap:8px}
.amen span{padding:6px 12px;border-radius:999px;background:var(--surface);font-size:13px}
.rates{display:grid;gap:0;border:1px solid var(--divider);border-radius:var(--r-m);overflow:hidden}
.rates div{display:flex;justify-content:space-between;padding:12px 14px}
.rates div+div{border-top:1px solid var(--divider)}

/* ============ Tabla de tarifas por cantidad de personas ============ */
.tar-wrap{border:1px solid var(--divider);border-radius:var(--r-m);overflow-x:auto}
.tar-table{width:100%;border-collapse:collapse;font-size:13px;min-width:420px}
.tar-table th{text-align:right;color:var(--text2);font-weight:600;padding:10px 12px;background:var(--surface);white-space:nowrap;font-size:12px}
.tar-table th:first-child{text-align:left}
.tar-table td{padding:11px 12px;border-top:1px solid var(--divider);text-align:right;white-space:nowrap}
.tar-table td:first-child{text-align:left;white-space:normal}
.tar-table tr.on td{background:var(--primary-light)}
.tar-table b{font-weight:700}
.tar-table .pp{display:block;font-size:11px;color:var(--text2);font-weight:500}
.tar-note{font-size:12px;color:var(--text2);margin-top:8px}
.pill-paq{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:999px;background:var(--ok-bg);color:var(--ok);font-size:12px;font-weight:700}
.tier-line{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:10px;padding:10px 12px;border-radius:12px;background:#fff;border:1px solid var(--divider);font-size:13px}
.tier-line b{white-space:nowrap}
.tier-line.bad{border-color:var(--danger);color:var(--danger)}

.strip{display:grid;grid-template-columns:repeat(14,1fr);gap:4px}
.strip div{border-radius:8px;padding:6px 0;text-align:center;font-size:11px;background:var(--surface)}
.strip div b{display:block;font-size:13px}
.strip div.busy{background:var(--divider);color:var(--inactive);text-decoration:line-through}
.strip div.fs{box-shadow:inset 0 0 0 1.5px var(--primary-light)}
.review{padding:14px 0;border-bottom:1px solid var(--divider)}
.review:last-child{border-bottom:0}
.avatar{width:48px;height:48px;border-radius:50%;background:var(--primary-light);color:var(--primary-dark);display:grid;place-items:center;font-weight:700;flex-shrink:0}
.avatar.sm{width:36px;height:36px;font-size:13px}
.sticky-cta{position:sticky;bottom:0;z-index:15;display:flex;align-items:center;gap:16px;padding:16px 0 calc(16px + var(--safe-b));background:linear-gradient(to top,#fff 78%,rgba(255,255,255,0));margin-top:24px}
.sticky-cta .btn{flex:1}
@media(min-width:1024px){
  .detail{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:40px;max-width:1180px;margin:0 auto;padding:24px var(--pad)}
  .d-media{height:calc(100vh - 112px);position:sticky;top:88px;border-radius:var(--r-l)}
  .d-sheet{margin-top:0;padding:8px 0 0;border-radius:0}
}

/* ============ Reserva (screen_1) ============ */
.bk-layout{display:flex;flex-direction:column;padding-bottom:8px}
.bk-main,.bk-side{display:contents}
.o-first{order:-1}
@media(min-width:1024px){
  .bk-layout{display:grid;grid-template-columns:minmax(0,1fr) 390px;gap:32px;align-items:start}
  .bk-main,.bk-side{display:block}
  .bk-side{position:sticky;top:84px}
}
.profile{display:flex;align-items:center;gap:14px;padding:14px;border-radius:var(--r-card);background:var(--surface);width:100%;text-align:left}
.profile .p-info{flex:1;min-width:0}
.profile .p-info b{display:block;font-size:16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.profile .p-info span{color:var(--text2);font-size:13px}
.edit-btn{width:36px;height:36px;border-radius:50%;background:var(--primary);color:#fff;display:grid;place-items:center;flex-shrink:0}
.cab-mini{display:flex;align-items:center;gap:12px;padding:10px;border:1px solid var(--divider);border-radius:var(--r-m);width:100%;margin-top:16px;text-align:left}
.cab-mini .th{width:56px;height:56px;border-radius:12px;background:var(--primary-light) center/cover;flex-shrink:0}
.cab-mini b{display:block}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{display:inline-flex;align-items:center;gap:8px;padding:10px 14px;border-radius:var(--r-btn);border:1px solid var(--divider);background:#fff;font-weight:500;white-space:nowrap}
.chip.on{border-color:var(--primary);background:var(--primary-light);color:var(--primary-dark)}
.chip .tag{margin-left:2px}
.type-desc{margin-top:10px;color:var(--text2)}
.cal{background:var(--surface);border-radius:var(--r-card);padding:16px}
.cal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.cal-head b{font-size:16px;text-transform:capitalize}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);row-gap:4px}
.cal-dow{font-size:11px;color:var(--text2);text-align:center;font-weight:600;padding:6px 0;letter-spacing:.03em}
.day{height:42px;display:grid;place-items:center}
.day button{width:38px;height:38px;border-radius:50%;font-weight:500;font-size:14px;text-align:center;position:relative}
.day button:hover{background:#fff}
.day.past button,.day.off button{color:var(--inactive);cursor:default}
.day.past button:hover,.day.off button:hover{background:transparent}
.day.occ button{color:var(--inactive);text-decoration:line-through}
.day.fs button{color:var(--primary-dark)}
.day.in{background:var(--primary-light)}
.day.start{background:linear-gradient(90deg,transparent 50%,var(--primary-light) 50%)}
.day.end{background:linear-gradient(90deg,var(--primary-light) 50%,transparent 50%)}
.day.start.end{background:none}
.day.start button,.day.end button{background:var(--primary)!important;color:#fff!important;text-decoration:none}
.day.rec button{box-shadow:inset 0 0 0 2px var(--primary);color:var(--primary-dark)}
.day.today button::after{content:"";position:absolute;bottom:4px;left:50%;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:var(--primary)}
.day.start.today button::after,.day.end.today button::after{background:#fff}
.cal-legend{display:flex;gap:14px;flex-wrap:wrap;margin-top:10px;font-size:12px;color:var(--text2)}
.cal-legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:-1px}
.cal-hint{margin-top:10px;font-weight:500}
.cal-hint.err{color:var(--danger)}
.panel{background:var(--surface);border-radius:var(--r-card);padding:16px}
.lbl{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:15px}
.lbl .ic{color:var(--primary)}
.tp{display:flex;align-items:center;justify-content:center;gap:10px;margin-top:12px}
.tp-col{display:flex;flex-direction:column;align-items:center;gap:4px}
.tp-col button{width:52px;height:28px;border-radius:8px;color:var(--text2);display:grid;place-items:center}
.tp-col button:hover{background:#fff;color:var(--primary)}
.tp-val{font-size:28px;font-weight:700;width:68px;height:56px;display:grid;place-items:center;background:#fff;border-radius:var(--r-btn);border:1px solid var(--divider)}
.tp-val.period{font-size:18px;color:var(--primary)}
.tp-sep{font-size:28px;font-weight:700}
.stepper{display:flex;align-items:center;gap:14px}
.stepper button{width:40px;height:40px;border-radius:var(--r-btn);display:grid;place-items:center}
.stepper .minus{background:var(--minus);color:var(--text)}
.stepper .plus{background:var(--primary);color:#fff}
.stepper b{font-size:18px;min-width:26px;text-align:center}
.mstep{display:flex;align-items:center;gap:10px}
.mstep button{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;background:#fff;border:1px solid var(--divider)}
.mstep button.plus{background:var(--primary);border-color:var(--primary);color:#fff}
.mstep b{min-width:20px;text-align:center;font-size:15px}
.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;background:#fff;border:1px solid var(--divider);border-radius:var(--r-btn);padding:4px;margin-top:12px}
.seg button{padding:8px 0;border-radius:9px;font-weight:600;color:var(--text2);text-align:center}
.seg button.on{background:var(--primary);color:#fff}
.occ-list{list-style:none;margin-top:12px;display:grid;gap:6px}
.occ-list li{display:flex;align-items:center;gap:10px;font-size:13px;padding:8px 10px;background:#fff;border-radius:10px}
.occ-list li span{width:22px;height:22px;border-radius:50%;background:var(--primary-light);color:var(--primary-dark);display:grid;place-items:center;font-size:11px;font-weight:700;flex-shrink:0}
.occ-list li.bad{color:var(--danger)}
.occ-list li.bad span{background:#FDECEC;color:var(--danger)}
.occ-list em{margin-left:auto;font-style:normal;font-weight:600}
.promo-box{display:flex;gap:8px}
.promo-box .input{text-transform:uppercase}
.summary{border:1px solid var(--divider);border-radius:var(--r-card);padding:16px}
