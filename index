  if (el.dataset.in) {
    setPath(el.dataset.in, el.value);
    if (el.dataset.in === 'q.ci' && S.q.ci && (!S.q.co || S.q.co <= S.q.ci)) S.q.co = D.add(S.q.ci, 1);
    render();
    return;
  }
  if (el.dataset.chg === 'nrTipo') return nrTipoChanged(el);
  if (el.dataset.chg === 'nrPrev') return nrPreview();
  if (el.dataset.chg === 'tarPrev') return tarifaPreview();
  if (el.dataset.chg === 'logoPrev') return updateLogoPreview();
  if (el.dataset.live === 'msgPrev') return refreshMsgPreviews();
  if (el.dataset.chg === 'rolDesc') {
    const r = S.ad.d.roles.find(x => x.id === el.value);
    $('#rolDesc').textContent = r ? r.descripcion : '';
    return;
  }
  if (el.dataset.chg === 'acepta') { $('#sendBtn').disabled = !el.checked; return; }
  // Días de tarifa alta: refleja el estado visual del chip
  if (/^dow_\d$/.test(el.name || '')) {
    const chip = el.closest('.chip');
    if (chip) chip.classList.toggle('on', el.checked);
    return;
  }
  if (el.dataset.chg === 'resEstado') {
    const id = el.dataset.id;
    const val = el.value;
    const r = S.ad.d && S.ad.d.reservas.find(x => x.ID === id);
    if (!r) { toast('No encontramos esa reserva. Tocá Actualizar arriba a la derecha.'); return; }
    const anterior = r.Estado;
    if (val === anterior) return;                     // no molestamos al servidor al vacío
 
    const run = async () => {
      const d = await adminCall('adminUpdateReservation', id, { Estado: val });
      if (!d) { render(); return; }                   // hubo error: el select vuelve al valor real
      const nuevo = (d.reservas || []).find(x => x.ID === id);
      refreshPublicSoon();
      render();
      if (!nuevo) {
        toast(`${r.Codigo}: la reserva ya no está en la hoja.`);
      } else if (String(nuevo.Estado).trim() === val) {
        const filtrada = S.ad.f.estado && S.ad.f.estado !== val;
        toast(`${r.Codigo}: ${val}.` + (filtrada ? ' Sale del filtro actual.' : ''));
      } else {
        // Antes esto pasaba en silencio y parecía que se había guardado.
        toast(`No se pudo guardar el estado de ${r.Codigo}. Ejecutá diagnostico() en Apps Script.`);
      }
    };
 
    if (val === 'Cancelada') {
      el.value = anterior;
      confirmBox('Cancelar reserva',
        `La reserva ${esc(r.Codigo)} de ${esc(r.Cliente)} libera sus fechas y el evento del calendario se marca como cancelado.`,
        'Cancelar reserva', run, true);
    } else {
      run();
    }
    return;
  }
});

document.addEventListener('input', e => {
  const el = e.target;
  if (el.dataset.live === 'resSearch') {
    S.ad.f.q = el.value;
    $('#resTable').innerHTML = resRows();
    if ($('#resCount')) $('#resCount').innerHTML = resCountTxt();
  }
  if (el.dataset.chg === 'tarPrev') tarifaPreview();
  if (el.dataset.chg === 'nrPrev') nrPreview();
  if (el.dataset.live === 'logoPrev') updateLogoPreview();
  if (el.dataset.live === 'msgPrev') refreshMsgPreviews();
  if (el.dataset.live === 'imgPrev') {
    $('#imgPrev').setAttribute('style', bg(imgUrl(el.value)));
  }
});

document.addEventListener('focusin', e => {
  const t = e.target;
  const form = t.closest && t.closest('#msgForm, #recForm');
  if (form && t.name && (t.tagName === 'TEXTAREA' || (t.tagName === 'INPUT' && t.type === 'text'))) S.ad.lastField[form.id] = t.name;
});

document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && $('#modal-root').innerHTML) closeModal();
  if (e.key === 'Enter') {
    if (e.target.closest('#loginForm')) { e.preventDefault(); doLogin(); }
    else if (e.target.id === 'promoInput') { e.preventDefault(); A.applyPromo(); }
    else if (e.target.closest('#lkForm')) { e.preventDefault(); doLookup(); }
    else if (e.target.matches('.profile')) { e.preventDefault(); openGuestModal(); }
  }
});

/* =================================================================
 *  Refresco automático
 *  El panel guarda los datos en memoria. Si alguien edita la hoja en
 *  otra pestaña, al volver a esta se vuelven a leer solos.
 * ================================================================= */
let ultimoRefresh = Date.now();
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState !== 'visible') return;
  if (Date.now() - ultimoRefresh < 15000) return;     // no relee a cada cambio de pestaña
  if ($('#modal-root').innerHTML) return;             // hay un formulario abierto: no lo pisa
  ultimoRefresh = Date.now();
  if (S.view === 'admin' && S.ad.token) loadAdmin();
  else if (S.view === 'staff' && S.ad.token) loadStaff();
  else if (S.view === 'home' || S.view === 'detail') refreshPublicNow().then(render);
});

/* =================================================================
 *  Inicio
 * ================================================================= */
async function init() {
  $('#view').innerHTML = loadingView();
  try {
    S.data = await call('getPublicData');
    PR.init(S.data.config);
    indexOcc(S.data.ocupacion);
    const tk = store.get('adm_tk');
    if (tk) {
      S.ad.token = tk;
      try { S.ad.user = JSON.parse(store.get('adm_user') || 'null'); } catch (e) { S.ad.user = null; }
      S.ad.panel = (S.ad.user && S.ad.user.panel) || 'admin';
    }
    render();
  } catch (e) {
    $('#appbar').innerHTML = '';
    $('#view').innerHTML = `<div class="loading"><div style="max-width:420px;padding:20px">
      <div class="ok-circle" style="background:var(--primary-light);color:var(--primary)">${ic('info', 34)}</div>
      <h2 style="color:var(--text)">No pudimos cargar las cabañas</h2>
      <p class="mt8">${esc(e.message)}</p>
      <p class="small mt8">Si es la primera vez, ejecutá setupDemoData() desde el editor de Apps Script. Si venís de una versión anterior, ejecutá actualizarEstructura().</p>
      <button class="btn btn-primary mt16" onclick="init()">Reintentar</button></div></div>`;
  }
}
init();

</script>
</body>
</html>
