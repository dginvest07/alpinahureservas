/* ---------------- Agenda de limpieza ---------------- */
function staffDay(a, day) {
  const es = a.estadias;
  const salidas = es.filter(e => !e.diaDeCampo && e.salida === day);
  const entradas = es.filter(e => !e.diaDeCampo && e.entrada === day);
  const campo = es.filter(e => e.diaDeCampo && e.entrada === day);
  const ocupadas = es.filter(e => !e.diaDeCampo && e.entrada < day && e.salida > day);
  const recambio = new Set(salidas.map(e => e.cabanaId).filter(id => entradas.some(x => x.cabanaId === id)));
  return { salidas, entradas, campo, ocupadas, recambio };
}

function vStaff() {
  const a = S.st;
  if (!a) return loadingView('Cargando agenda…');
  const days = Array.from({ length: a.dias }, (_, i) => D.add(a.desde, i));
  const first = staffDay(a, days[0]);
  const cuando = days[0] === a.hoy ? 'hoy' : days[0] === D.add(a.hoy, 1) ? 'mañana' : D.short(days[0]);
  const rangos = [['hoy', 'Hoy'], ['manana', 'Mañana'], ['7', '7 días'], ['14', '14 días']];
  return `<div class="wrap staff">
    <div class="a-head mt16"><div><h1>Agenda de limpieza</h1><p class="muted">Hola ${esc(a.usuario.nombre)}. Entradas y salidas de ${esc(a.negocio)}.</p></div>
      <div class="a-actions"><button class="btn btn-soft sm" data-a="staffReload">${ic('refresh', 18)} Actualizar</button></div></div>
    <div class="chips">${rangos.map(([k, l]) => `<button class="chip ${S.stRange === k ? 'on' : ''}" data-a="staffRange" data-r="${k}">${l}</button>`).join('')}</div>
    <div class="stats mt16">
      <div class="stat hl"><span>Salidas ${cuando}</span><b>${first.salidas.length}</b></div>
      <div class="stat"><span>Entradas ${cuando}</span><b>${first.entradas.length}</b></div>
      <div class="stat"><span>Recambios ${cuando}</span><b>${first.recambio.size}</b></div>
      <div class="stat"><span>Deep Work Days ${cuando}</span><b>${first.campo.length}</b></div>
      <div class="stat"><span>Cabañas en uso ${cuando}</span><b>${new Set([...first.salidas, ...first.entradas, ...first.campo, ...first.ocupadas].map(e => e.cabanaId)).size}</b></div>
    </div>
    <p class="muted small mt12">Salida habitual hasta las ${esc(a.checkout)} hs. Entrada habitual desde las ${esc(a.checkin)} hs.</p>
    ${days.map(day => staffDayCard(a, day)).join('')}
    <div style="height:32px"></div>
  </div>`;
}

function staffDayCard(a, day) {
  const x = staffDay(a, day);
  const eventos = [
    ...x.salidas.map(e => ({ hora: e.horaSalida, orden: 0, e, t: 'salida' })),
    ...x.campo.map(e => ({ hora: e.horaEntrada, orden: 1, e, t: 'campo' })),
    ...x.entradas.map(e => ({ hora: e.horaEntrada, orden: 2, e, t: 'entrada' }))
  ].sort((p, q) => p.hora.localeCompare(q.hora) || p.orden - q.orden);
  const dt = D.parse(day);
  const titulo = dt.toLocaleDateString('es-PY', { weekday: 'long', day: 'numeric', month: 'long' });
  const tag = day === a.hoy ? '<span class="tag">Hoy</span>' : day === D.add(a.hoy, 1) ? '<span class="tag soft">Mañana</span>' : '';
  const fila = ({ t, e }) => {
    const rec = x.recambio.has(e.cabanaId);
    const entradaMismaCabana = x.entradas.find(z => z.cabanaId === e.cabanaId);
    let tarea;
    if (t === 'salida') tarea = rec ? `Recambio: limpiar después de las ${e.horaSalida} y dejar lista antes de las ${entradaMismaCabana.horaEntrada}.` : `Limpiar después de las ${e.horaSalida}.`;
    else if (t === 'entrada') tarea = rec ? 'Llega después del recambio.' : `Dejar lista antes de las ${e.horaEntrada}.`;
    else tarea = `Lista antes de las ${e.horaEntrada}. Limpiar después de las ${e.horaSalida}.`;
    const label = { salida: 'Salida', entrada: 'Entrada', campo: 'Deep Work Day' }[t];
    const icono = { salida: 'logout', entrada: 'login', campo: 'sun' }[t];
    const hora = t === 'salida' ? esc(e.horaSalida) : t === 'campo' ? `${esc(e.horaEntrada)}<small>a ${esc(e.horaSalida)}</small>` : esc(e.horaEntrada);
    return `<div class="mov mov-${t}">
      <div class="mov-time">${hora}</div>
      <div class="mov-ico">${ic(icono, 18)}</div>
      <div class="mov-body">
        <div class="row" style="flex-wrap:wrap;gap:6px"><b>${esc(e.cabana)}</b><span class="mov-lbl">${label}</span>${rec ? '<span class="tag">Recambio</span>' : ''}${e.estado === 'Pendiente' ? '<span class="tag soft">Sin confirmar</span>' : ''}</div>
        <div class="muted small">${plural(e.huespedes, 'huésped', 'huéspedes')}${e.huesped ? `, ${esc(e.huesped)}` : ''}${t === 'entrada' && !e.diaDeCampo ? `, hasta el ${D.short(e.salida)}` : ''}</div>
        <div class="mov-task">${esc(tarea)}</div>
      </div>
    </div>`;
  };
  return `<section class="day-card">
    <div class="day-head"><h2>${esc(titulo)}</h2>${tag}<span class="muted small" style="margin-left:auto">${eventos.length ? plural(eventos.length, 'movimiento', 'movimientos') : ''}</span></div>
    ${eventos.length ? eventos.map(fila).join('') : '<p class="muted">Sin entradas ni salidas.</p>'}
    ${x.ocupadas.length ? `<p class="small muted mt8">Con huéspedes todo el día: ${x.ocupadas.map(e => `${esc(e.cabana)} (hasta el ${D.short(e.salida)})`).join(', ')}.</p>` : ''}
  </section>`;
}

