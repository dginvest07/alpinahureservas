function calendarWidget() {
  const b = S.bk, t = tipo(), hoy = S.data.hoy;
  const m = b.month;
  const occ = S.occ[S.cabId] || new Set();
  const est = estimate();
  const recStarts = new Set(est && est.occ && t.Modo === 'RECURRENTE' ? est.occ.slice(1).map(o => o.ci) : []);
  const first = new Date(m.getFullYear(), m.getMonth(), 1);
  const daysIn = new Date(m.getFullYear(), m.getMonth() + 1, 0).getDate();
  const canPrev = first > D.parse(hoy.slice(0, 8) + '01');
  const dows = ['DOM', 'LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB'];

  let cells = '';
  for (let i = 0; i < first.getDay(); i++) cells += '<div></div>';
  for (let d = 1; d <= daysIn; d++) {
    const iso = D.iso(new Date(m.getFullYear(), m.getMonth(), d));
    const cls = ['day'];
    if (iso < hoy) cls.push('past');
    if (occ.has(iso)) cls.push('occ');
    if (t.Modo === 'FINDE' && D.dow(iso) !== 5) cls.push('off');
    if (PR.esFinde(iso)) cls.push('fs');
    if (iso === hoy) cls.push('today');
    if (b.ci && iso === b.ci) cls.push('start');
    if (b.co && iso === b.co) cls.push('end');
    if (b.ci && b.co && iso > b.ci && iso < b.co) cls.push('in');
    if (recStarts.has(iso)) cls.push('rec');
    const label = D.full(iso) + (occ.has(iso) ? ', ocupado' : '') + (PR.esFeriado(iso) ? ', feriado' : '');
    cells += `<div class="${cls.join(' ')}"><button data-a="pickDay" data-d="${iso}" aria-label="${label}">${d}</button></div>`;
  }
  return `<div class="cal">
    <div class="cal-head">
      <button class="icon-btn" data-a="month" data-d="-1" aria-label="Mes anterior" ${canPrev ? '' : 'disabled'}>${ic('chevron-left')}</button>
      <b>${D.monthName(m)}</b>
      <button class="icon-btn" data-a="month" data-d="1" aria-label="Mes siguiente">${ic('chevron-right')}</button>
    </div>
    <div class="cal-grid">${dows.map(x => `<div class="cal-dow">${x}</div>`).join('')}${cells}</div>
    <div class="cal-legend">
      <span><i style="background:var(--primary)"></i>Tu selección</span>
      <span><i style="background:var(--divider)"></i>Ocupado</span>
      <span><i style="background:var(--primary-light)"></i>Tarifa ${esc(txtFinde().toLowerCase())}</span>
      ${t.Modo === 'RECURRENTE' ? '<span><i style="box-shadow:inset 0 0 0 2px var(--primary)"></i>Repeticiones</span>' : ''}
    </div></div>`;
}

function calHint() {
  const b = S.bk, t = tipo(), est = estimate();
  if (t.Modo === 'DIA') return { text: b.ci ? `Deep Work Day el ${D.full(b.ci)}.` : 'Tocá el día de tu jornada.' };
  if (t.Modo === 'FINDE') return { text: b.ci ? `Del viernes ${D.short(b.ci)} al domingo ${D.short(b.co)}.` : 'Tocá un viernes: el paquete va de viernes a domingo.' };
  if (!b.ci) return { text: 'Tocá tu día de llegada.' };
  if (!b.co) return { text: `Llegada ${D.long(b.ci)}. Ahora tocá tu día de salida.` };
  const n = D.diff(b.ci, b.co);
  const err = est && est.errors && est.errors.find(e => /noches|repetición/.test(e));
  return err ? { text: err, err: true } : { text: `${plural(n, 'noche', 'noches')}: ${D.long(b.ci)} al ${D.long(b.co)}.` };
}

