    <div class="total"><span>Total</span><b>${money(est.total)}</b></div>
    ${est.sena ? `<div class="sena"><span>Seña para confirmar (${cfg.senaPct}%)</span><span>${money(est.sena)}</span></div>` : ''}
  </div>`;
}

