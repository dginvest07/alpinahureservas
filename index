  } catch (e) {
    busy(false);
    toast(e.message);
  }
}

async function sendBooking() {
  busy(true);
  try {
    const acepta = $('#acepta');
    S.pending.aceptaCondiciones = !!(acepta && acepta.checked);
    const res = await call('createReservation', S.pending);
    S.lastRes = res;
    indexOcc(res.ocupacion);
    closeModal();
    busy(false);
    go('success');
  } catch (e) {
    busy(false);
    closeModal();
    toast(e.message);
  }
}

