    ${lista.map(tarifasCard).join('')}`;
}

/** Todos los tramos de una cabaña, incluidos los desactivados (c.Tarifas trae solo los activos). */
function tarifasDeCab(cabId) {
  return (S.ad.d.tarifas || []).filter(t => t.CabanaID === cabId).sort((a, b) => a.MinPersonas - b.MinPersonas);
}

function tarifasCard(c) {
  const lista = tarifasDeCab(c.ID);
  const hayPaquete = lista.some(t => t.PrecioPaquete > 0);
  const filas = lista.map(t => {
    const rango = t.MinPersonas === (t.MaxPersonas || t.MinPersonas)
      ? plural(t.MinPersonas, 'persona', 'personas') : `${t.MinPersonas} a ${t.MaxPersonas} personas`;
    const por = t.TipoPrecio === 'PERSONA' ? ' <span class="muted small">p/persona</span>' : ' <span class="muted small">la cabaña</span>';
    // Ejemplo con el máximo del tramo, que es donde más se nota el precio por persona
    const ej = t.MaxPersonas || t.MinPersonas;
    return `<tr>
      <td data-l="Tramo"><b>${esc(t.Nombre || rango)}</b><div class="muted small">${esc(rango)}</div></td>
      <td data-l="${esc(txtSemana())}" class="nw"><b>${money(t.PrecioSemana)}</b>${por}</td>
      <td data-l="${esc(txtFinde())}" class="nw"><b>${money(t.PrecioFinSemana)}</b>${por}</td>
      ${hayPaquete ? `<td data-l="Paquete" class="nw">${t.PrecioPaquete > 0
        ? `<b>${money(t.PrecioPaquete)}</b>${t.TipoPaquete === 'PERSONA' ? ' <span class="muted small">p/persona</span>' : ''}<div class="muted small">desde ${t.PaqueteMinNoches || 2} noches</div>`
        : '<span class="muted">—</span>'}</td>` : ''}
      <td data-l="Ejemplo" class="nw muted small">${ej} pers.: <b>${money(precioNoche(t, c, ej, false, false))}</b> / noche</td>
      <td data-l="Activa"><button class="sw ${t.Activa ? 'on' : ''}" data-a="toggle" data-s="Tarifas" data-k="${esc(t.ID)}" data-v="${!t.Activa}" aria-label="Activar o desactivar ${esc(t.Nombre)}"></button></td>
      <td data-l=""><div class="row-act">
        <button class="icon-btn" data-a="editTarifa" data-id="${esc(t.ID)}" aria-label="Editar tramo">${ic('edit-2', 16)}</button>
        <button class="icon-btn" data-a="delTarifa" data-id="${esc(t.ID)}" aria-label="Eliminar tramo">${ic('trash', 16)}</button>
      </div></td></tr>`;
  }).join('');

  const huecos = huecosTramos(c);
  return `<section class="a-card mt16">
    <div class="a-head" style="margin-bottom:12px">
      <div><h2 style="margin:0">${esc(c.Nombre)}</h2><p class="muted small">Capacidad: ${plural(c.Capacidad, 'huésped', 'huéspedes')}</p></div>
      <div class="a-actions">
        ${lista.length ? '' : `<button class="btn btn-soft sm" data-a="seedTarifas" data-id="${c.ID}">${ic('zap', 16)} Cargar tramos del flyer</button>`}
        <button class="btn btn-primary sm" data-a="editTarifa" data-id="" data-cab="${c.ID}">${ic('plus', 16)} Nuevo tramo</button>
      </div>
    </div>
    ${lista.length ? `<div class="tbl-wrap"><table class="table cards"><thead><tr>
        <th>Tramo</th><th>${esc(txtSemana())}</th><th>${esc(txtFinde())}</th>${hayPaquete ? '<th>Paquete entre semana</th>' : ''}<th>Ejemplo</th><th>Activa</th><th></th>
      </tr></thead><tbody>${filas}</tbody></table></div>`
      : `<p class="empty">Sin tramos cargados: esta cabaña cobra el precio base único de ${money(c.PrecioNoche)}. Usá "Cargar tramos sugeridos" para partir de los precios del flyer y después editarlos.</p>`}
    ${huecos.length ? `<p class="hint mt12 err">${ic('info', 14)} Sin precio para ${huecos.join(', ')}. Esas cantidades no van a poder reservar online.</p>` : ''}
