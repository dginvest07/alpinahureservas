/* =================================================================
 *  Motor de reserva (cliente)
 * ================================================================= */
function to24(b) { let h = b.h % 12; if (b.p === 'PM') h += 12; return `${pad2(h)}:${pad2(b.m)}`; }
function from24(s) {
  const [H, M] = String(s || '14:00').split(':').map(Number);
  return { h: (H % 12) || 12, m: Math.round((M || 0) / 15) * 15 % 60, p: H >= 12 ? 'PM' : 'AM' };
}

function initBooking(id) {
  const prev = S.bk || {};
  const c = cab(id);
  const t = S.data.tipos.find(x => x.Modo === prev.tipo) || S.data.tipos[0];
  const hora = from24(S.data.config.checkin);
  S.cabId = id;
  S.bk = Object.assign({
    tipo: t ? t.Modo : '',
    ci: S.q.ci || '', co: S.q.co || '',
    g: Math.min(S.q.g || 2, c.Capacidad),
    freq: prev.freq || 'SEMANAL', rep: prev.rep || 4,
    promo: '',
    cliente: prev.cliente || '', telefono: prev.telefono || '', email: prev.email || '', notas: prev.notas || ''
  }, hora);
  if (S.bk.ci && !isFree(id, S.bk.ci, S.bk.co)) { S.bk.ci = ''; S.bk.co = ''; }
  normalizeMode();
  const base = D.parse(S.bk.ci || S.data.hoy);
  S.bk.month = new Date(base.getFullYear(), base.getMonth(), 1);
}

function normalizeMode() {
  const b = S.bk, t = tipo();
  if (!t) return;
  if (t.Modo === 'DIA') { b.co = b.ci; }
  else if (t.Modo === 'FINDE') {
    if (b.ci && D.dow(b.ci) !== 5) { b.ci = ''; b.co = ''; }
    else if (b.ci) b.co = D.add(b.ci, 2);
  } else if (b.co && b.co <= b.ci) { b.co = ''; }
}

function promoCheck(code, n) {
  const b = S.bk, c = cab(), t = tipo();
  const p = S.data.promos.find(x => x.Codigo.toUpperCase() === String(code).toUpperCase());
  if (!p) return { msg: 'Ese código no existe o ya venció.' };
  if (p.CabanaID !== 'TODAS' && p.CabanaID !== c.ID) return { msg: 'Este código no aplica a esta cabaña.' };
  if (p.TipoModo !== 'TODOS' && p.TipoModo !== t.Modo) return { msg: 'Este código no aplica a este tipo de reserva.' };
  if (b.ci && p.FechaInicio && b.ci < p.FechaInicio) return { msg: `Válido para llegadas desde el ${D.short(p.FechaInicio)}.` };
  if (b.ci && p.FechaFin && b.ci > p.FechaFin) return { msg: `Válido para llegadas hasta el ${D.short(p.FechaFin)}.` };
  if (p.MinNoches && n < p.MinNoches) return { msg: `Requiere al menos ${plural(p.MinNoches, "noche", "noches")}.` };
  return { ok: true, promo: p, msg: `${p.DescuentoPct}% de descuento aplicado.` };
}

function estimate() {
  const b = S.bk, c = cab(), t = tipo(), cfg = S.data.config;
  if (!c || !t || !b.ci) return null;
  const modo = t.Modo;
  const n = modo === 'DIA' ? 0 : (b.co ? D.diff(b.ci, b.co) : 0);
  if (modo !== 'DIA' && n < 1) return null;

  const gTarifa = huespedesParaTarifa(modo, b.g);
  const tar = tarifaPara(c, gTarifa);
  if ((c.Tarifas || []).length && !tar) {
    return {
      sinTarifa: true, modo, n, g: b.g, occ: [], subtotal: 0, total: 0, sena: 0, descuento: 0, pct: 0,
      tipoPct: 0, promoPct: 0, paquete: false, tarifa: null, detalle: null, pc: null,
      errors: [`Para ${plural(b.g, 'huésped', 'huéspedes')} no hay una tarifa cargada en ${c.Nombre}. Escribinos y la armamos a medida.`]
    };
  }

  let occ = [{ ci: b.ci, co: modo === 'DIA' ? b.ci : b.co }];
  if (modo === 'RECURRENTE') {
    occ = [];
    for (let i = 0; i < b.rep; i++) {
      const ci = b.freq === 'MENSUAL' ? D.addMonths(b.ci, i) : D.add(b.ci, i * (b.freq === 'QUINCENAL' ? 14 : 7));
      occ.push({ ci, co: D.add(ci, n) });
    }
  }

  const det = {
    nochesSemana: 0, nochesFinde: 0, nochesPaquete: 0,
    precioSemana: precioNoche(tar, c, gTarifa, false, false),
    precioFinde: precioNoche(tar, c, gTarifa, true, false),
    precioPaquete: (tar && tar.PrecioPaquete > 0) ? precioNoche(tar, c, gTarifa, false, true) : 0,
    deepWork: 0
  };

  occ.forEach(o => {
    o.free = isFree(c.ID, o.ci, o.co);
    let s = 0;
    if (modo === 'DIA') {
      // Se calcula sobre el precio diario de este tramo de huéspedes y de esta fecha.
      s = Math.round(precioNoche(tar, c, gTarifa, PR.esFinde(o.ci), false) * cfg.deepWorkPct / 100);
      det.deepWork = s;
      o.paquete = false;
    } else {
      const fechas = [];
      for (let i = 0; i < n; i++) fechas.push(D.add(o.ci, i));
      o.paquete = aplicaPaquete(tar, fechas);
      fechas.forEach(f => {
        const finde = PR.esFinde(f);
        s += precioNoche(tar, c, gTarifa, finde, o.paquete);
        if (o.paquete) det.nochesPaquete++;
        else if (finde) det.nochesFinde++;
        else det.nochesSemana++;
      });
    }
    o.sub = s;
  });

  const errors = [];
  if (modo !== 'DIA') {
    if (t.MinNoches && n < t.MinNoches) errors.push(`${t.Nombre} requiere al menos ${t.MinNoches} noches.`);
    if (t.MaxNoches && n > t.MaxNoches) errors.push(`${t.Nombre} permite hasta ${t.MaxNoches} noches.`);
  }
  if (modo === 'RECURRENTE') {
    const lim = { SEMANAL: 7, QUINCENAL: 14, MENSUAL: 28 }[b.freq];
    if (n >= lim) errors.push(`Con repetición ${b.freq.toLowerCase()} cada estadía debe durar menos de ${lim} noches.`);
  }
  const bad = occ.filter(o => !o.free);
  if (bad.length) errors.push(`La cabaña está ocupada el ${bad.map(o => D.short(o.ci)).join(', ')}.`);
  if (b.g > c.Capacidad) errors.push(`${c.Nombre} admite hasta ${c.Capacidad} huéspedes.`);

  const pc = b.promo ? promoCheck(b.promo, n) : null;
  const subtotal = occ.reduce((a, o) => a + o.sub, 0);
  const tipoPct = t.DescuentoPct || 0;
  const promoPct = pc && pc.ok ? pc.promo.DescuentoPct : 0;
  const pct = Math.min(tipoPct + promoPct, cfg.maxDescuento);
  const descuento = Math.round(subtotal * pct / 100);
  const total = subtotal - descuento;
  return {
    modo, n, g: b.g, occ, subtotal, tipoPct, promoPct, pct, descuento, total,
    sena: Math.round(total * cfg.senaPct / 100),
    tarifa: tar, paquete: occ.some(o => o.paquete), detalle: det, errors, pc
  };
}

function buildPayload() {
  const b = S.bk, t = tipo();
  return {
