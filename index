function waNumber(tel) {
  let n = String(tel || '').replace(/\D/g, '');
  if (!n) return '';
  const cc = String((S.ad.d && S.ad.d.config.WA_CODIGO_PAIS) || '595').replace(/\D/g, '');
  if (n.startsWith('00')) n = n.slice(2);
  else if (n.startsWith('0')) n = cc + n.slice(1);
  else if (cc && !n.startsWith(cc) && n.length <= 9) n = cc + n;
  return n;
}
const waLink = (tel, text) => {
  const n = waNumber(tel);
  return n ? `https://wa.me/${n}?text=${encodeURIComponent(text || '')}` : '';
};

/** Variables de plantilla (mismo resultado que guestVars_ en el servidor). */
function tplVars(c, serie, f) {
  const money2 = n => `${c.SIMBOLO || 'Gs.'} ${nf.format(Math.round(n || 0))}`;
  const larga = iso => D.parse(iso).toLocaleDateString('es-PY', { day: 'numeric', month: 'short', year: 'numeric' }).replace('.', '');
  const senaPct = Number(c.SENA_PCT || 0);
  const base = {
    negocio: c.NEGOCIO_NOMBRE || '', whatsapp: c.WHATSAPP || c.TELEFONO || '', telefono: c.TELEFONO || '',
    direccion: c.DIRECCION || '', checkin: c.CHECKIN_HORA || '14:00', checkout: c.CHECKOUT_HORA || '10:00', sena_pct: String(senaPct)
  };
  const r = serie[0];
  const fechas = serie.map(x => larga(x.CheckIn) + (x.CheckOut !== x.CheckIn ? ' al ' + larga(x.CheckOut) : ''));
  const total = serie.reduce((a, x) => a + (x.Total || 0), 0);
  const sena = serie.reduce((a, x) => a + (x.Sena || 0), 0);
  const tarifaTxt = r.TarifaNombre ? r.TarifaNombre + (r.Paquete ? ' + paquete entre semana' : '') : '';
  const v = Object.assign({}, base, {
    nombre: r.Cliente, codigo: serie.map(x => x.Codigo).join(', '), cabana: r.CabanaNombre, tipo: r.TipoNombre,
    tarifa: tarifaTxt,
    fechas: fechas.join('\n'), huespedes: String(r.Huespedes), total: money2(total), sena: money2(sena), estado: r.Estado,
    datos_bancarios: f.DATOS_BANCARIOS || '(consultanos los datos por WhatsApp)',
    condiciones: fillTpl(f.CONDICIONES_RESERVA, base)
  });
  const hoy = (S.ad.d && S.ad.d.hoy) || (S.data && S.data.hoy) || r.CheckIn;
  const dias = D.diff(hoy, r.CheckIn);
  const cabx = ((S.ad.d && S.ad.d.cabanas) || []).find(x => x.ID === r.CabanaID) || {};
  const ubic = cabx.Ubicacion || c.DIRECCION || '';
  v.dias = String(Math.max(dias, 0));
  v.cuando = dias <= 0 ? 'hoy' : dias === 1 ? 'mañana' : `en ${dias} días`;
  v.llegada = `${D.parse(r.CheckIn).toLocaleDateString('es-PY', { weekday: 'long' })} ${larga(r.CheckIn)}`;
  v.hora_llegada = String(r.HoraLlegada || c.CHECKIN_HORA || '14:00');
  v.ubicacion = ubic;
  v.mapa = ubic ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ubic)}` : '';
  v.detalle = [`Cabaña: ${v.cabana}`, `Tipo: ${v.tipo}`, tarifaTxt ? `Tarifa: ${tarifaTxt}` : '', `Fechas: ${fechas.join(' / ')}`,
    `Huéspedes: ${v.huespedes}`, `Total: ${v.total}`, `Seña: ${v.sena}`].filter(Boolean).join('\n');
  return v;
}

