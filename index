/* ---------------- Usuarios ---------------- */
function aUsuarios() {
  const d = S.ad.d;
  const rol = id => d.roles.find(r => r.id === id) || { nombre: id, descripcion: '' };
  const yo = String(d.user.usuario || '').toLowerCase();
  const permisosPorRol = d.permisosRoles || {};
  const permisos = d.catalogoPermisos || [];
  const perfilCards = d.esDueno ? d.roles.map(r => {
    const asignados = permisosPorRol[r.id] || [];
    if (r.id === 'DUENO') return `<section class="a-card"><div class="row">${ic('lock', 18)}<b>Dueño</b></div><p class="muted small mt8">Acceso total fijo. No se puede limitar para evitar que la app quede sin administración.</p></section>`;
    return `<section class="a-card" id="perm-${esc(r.id)}"><div class="row">${ic(r.id === 'LIMPIEZA' ? 'broom' : 'users', 18)}<b>${esc(r.nombre)}</b></div>
      <p class="muted small mt8">${esc(r.descripcion)}</p>
      <div class="mt12">${permisos.map(p => `<label class="check"><input type="checkbox" name="permiso" value="${esc(p.id)}" ${asignados.includes(p.id) ? 'checked' : ''}> ${esc(p.nombre)} <span class="muted small">— ${esc(p.descripcion)}</span></label>`).join('')}</div>
      <button class="btn btn-outline sm mt12" data-a="saveRolePerm" data-r="${esc(r.id)}">Guardar permisos</button>
    </section>`;
  }).join('') : '';
  return `<div class="a-head"><div><h1>Usuarios</h1><p class="muted">Quién puede entrar al panel y qué puede ver.</p></div>
      <div class="a-actions"><button class="btn btn-primary sm" data-a="editUser" data-u="">${ic('plus', 18)} Nuevo usuario</button></div></div>
    <p class="hint" style="margin:-8px 0 16px">Las contraseñas se guardan protegidas fuera de la hoja de cálculo.</p>
    ${perfilCards ? `<h2 class="mt16">Permisos por perfil</h2><div class="acards" style="margin:12px 0 20px">${perfilCards}</div>` : ''}
    <div class="tbl-wrap"><table class="table cards"><thead><tr><th>Usuario</th><th>Nombre</th><th>Perfil</th><th>Estado</th><th>Último acceso</th><th></th></tr></thead>
      <tbody>${d.usuarios.map(u => `<tr>
        <td data-l="Usuario" class="code-t">${esc(u.Usuario)}${u.Usuario.toLowerCase() === yo ? ' <span class="tag">Vos</span>' : ''}</td>
