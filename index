async function confirmBooking() {
  const b = S.bk, t = tipo();
  const est = estimate();
  if (!est) return toast(t.Modo === 'DIA' ? 'Elegí el día de tu visita.' : 'Elegí las fechas de llegada y salida.');
  if (est.errors.length) return toast(est.errors[0]);
  if (b.promo && est.pc && !est.pc.ok) return toast('Quitá el código de promoción: ' + est.pc.msg);
  if (!b.cliente || !b.telefono || !b.email) { toast('Completá tus datos para reservar.'); return openGuestModal(); }
  const payload = buildPayload();
  busy(true);
  try {
    const q = await call('quoteReservation', payload);
    busy(false);
    S.pending = payload;
    const fechas = q.ocurrencias.map(o => q.modo === 'DIA' ? D.full(o.checkIn) : `${D.long(o.checkIn)} al ${D.long(o.checkOut)}`);
    modal(`${mHead('Revisá tu reserva')}
