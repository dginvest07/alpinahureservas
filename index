/* =================================================================
 *  PRECIOS: mismo motor que el servidor (tramos por cantidad de personas)
 * ================================================================= */
const DOW_NOMBRE = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];

const PR = {
  finde: new Set([5, 6, 0]),
  feriados: new Set(),
  init(cfg) {
    const d = (cfg && cfg.diasFinde && cfg.diasFinde.length) ? cfg.diasFinde : [5, 6, 0];
    PR.finde = new Set(d.map(Number));
    PR.feriados = new Set((cfg && cfg.feriados) || []);
  },
  esFinde(iso) { return PR.feriados.has(iso) || PR.finde.has(D.dow(iso)); },
  esFeriado(iso) { return PR.feriados.has(iso); }
};

/** "Lunes a jueves", "Viernes a domingo", etc. a partir de un conjunto de días. */
function diasTexto(set) {
  const orden = [1, 2, 3, 4, 5, 6, 0];
  const dias = orden.filter(d => set.has(d));
  if (!dias.length) return '';
  if (dias.length === 7) return 'Todos los días';
  const grupos = [];
  dias.forEach(d => {
    const g = grupos[grupos.length - 1];
    if (g && orden.indexOf(d) === orden.indexOf(g[g.length - 1]) + 1) g.push(d);
    else grupos.push([d]);
  });
  return cap1(grupos.map(g => g.length === 1
    ? DOW_NOMBRE[g[0]]
    : `${DOW_NOMBRE[g[0]]} a ${DOW_NOMBRE[g[g.length - 1]]}`).join(', '));
}
const txtSemana = () => diasTexto(new Set([0, 1, 2, 3, 4, 5, 6].filter(d => !PR.finde.has(d))));
const txtFinde = () => diasTexto(PR.finde) + (PR.feriados.size ? ' y feriados' : '');

/** Tramo de precio que corresponde a esa cantidad de huéspedes. */
function tarifaPara(c, g) {
  return (c && c.Tarifas || []).find(t =>
    g >= t.MinPersonas && g <= (t.MaxPersonas || t.MinPersonas)) || null;
}

/** Deep Work Day admite 1 persona, pero aplica la tarifa de pareja. */
function huespedesParaTarifa(modo, g) {
  const n = Math.max(g || 1, 1);
  return modo === 'DIA' && n === 1 ? 2 : n;
}

/** Precio de una noche ya multiplicado por la cantidad de personas cuando corresponde. */
function precioNoche(tar, c, g, finde, paquete) {
  const n = Math.max(g || 1, 1);
  if (!tar) return Math.round(finde ? (c.PrecioFinSemana || c.PrecioNoche) : c.PrecioNoche);
  if (paquete) return Math.round(tar.TipoPaquete === 'PERSONA' ? tar.PrecioPaquete * n : tar.PrecioPaquete);
  const base = finde ? (tar.PrecioFinSemana || tar.PrecioSemana) : tar.PrecioSemana;
  return Math.round(tar.TipoPrecio === 'PERSONA' ? base * n : base);
}

/** ¿Toda la estadía cae entre semana y dura lo suficiente? */
function aplicaPaquete(tar, fechas) {
  if (!tar || !(tar.PrecioPaquete > 0)) return false;
  const min = tar.PaqueteMinNoches || 2;
  if (!fechas.length || fechas.length < min) return false;
  return fechas.every(f => !PR.esFinde(f));
}

/** Precio por noche más bajo de la cabaña (para el "desde" de las tarjetas). */
function precioDesde(c) {
  if (c.PrecioDesde) return c.PrecioDesde;
  const lista = c.Tarifas || [];
  if (!lista.length) return c.PrecioNoche;
  let min = 0;
  lista.forEach(t => {
    const p = precioNoche(t, c, t.MinPersonas, false, false);
    if (p > 0 && (!min || p < min)) min = p;
  });
  return min || c.PrecioNoche;
}

/** Texto corto del tramo: "Gs. 165.000 por persona" o "Gs. 450.000 la cabaña". */
function precioTramoTxt(t, finde) {
  const base = finde ? (t.PrecioFinSemana || t.PrecioSemana) : t.PrecioSemana;
  return t.TipoPrecio === 'PERSONA' ? `${money(base)} <span class="pp">por persona</span>` : `${money(base)}`;
}

