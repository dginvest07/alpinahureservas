        <td data-l="Estado">${u.Activo ? '<span class="ok">Activo</span>' : '<span class="muted">Inactivo</span>'}</td>
        <td data-l="Último acceso" class="nw">${u.UltimoAcceso ? esc(u.UltimoAcceso) : '<span class="muted">Nunca</span>'}</td>
        <td data-l=""><div class="row-act">${d.esDueno || u.Rol !== 'DUENO' ? `<button class="icon-btn" data-a="editUser" data-u="${esc(u.Usuario)}" aria-label="Editar ${esc(u.Usuario)}">${ic('edit-2', 16)}</button>` : ''}</div></td>
      </tr>`).join('')}</tbody></table></div>`;
}

function editUser(usuario) {
  const d = S.ad.d;
