/** Muestra qué tramo de precio se va a aplicar en la reserva manual. */
function nrPreview() {
  const box = $('#nrPrev');
  if (!box) return;
  const f = formData($('#nrForm'));
  const c = (S.ad.d.cabanas || []).find(x => x.ID === f.cabanaId);
  const g = Number(f.huespedes) || 0;
  if (!c || g < 1) { box.textContent = ''; return; }
  if (g > c.Capacidad) { box.innerHTML = `<span class="err">${esc(c.Nombre)} admite hasta ${c.Capacidad} huéspedes.</span>`; return; }
  const t = tarifaPara(c, g);
  if (!t) {
    box.innerHTML = (c.Tarifas || []).length
      ? `<span class="err">No hay tramo cargado para ${g} personas en ${esc(c.Nombre)}.</span>`
      : `Precio base: ${money(c.PrecioNoche)} entre semana, ${money(c.PrecioFinSemana)} fin de semana.`;
    return;
  }
  box.innerHTML = `Tramo <b>${esc(t.Nombre)}</b>: ${money(precioNoche(t, c, g, false, false))} por noche ${esc(txtSemana().toLowerCase())}, ` +
    `${money(precioNoche(t, c, g, true, false))} ${esc(txtFinde().toLowerCase())}` +
    (t.PrecioPaquete > 0 ? `, paquete ${money(precioNoche(t, c, g, false, true))} por noche desde ${t.PaqueteMinNoches || 2} noches corridas entre semana.` : '.');
}

