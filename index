function filteredRes() {
  const { q, estado, cab: cabF } = S.ad.f;
  const txt = normTxt(q).trim();
  const dig = soloDigitos(q);
  return S.ad.d.reservas.filter(r => {
    if (estado && String(r.Estado || '').trim() !== estado) return false;
    if (cabF && String(r.CabanaID || '').trim() !== cabF) return false;
    if (!txt) return true;
    // Busca sin acentos ni mayúsculas en todos los campos visibles...
    const campos = normTxt([r.Codigo, r.Cliente, r.Email, r.Telefono, r.CabanaNombre, r.TarifaNombre].join(' '));
    if (campos.indexOf(txt) >= 0) return true;
    // ...y compara los teléfonos solo por sus dígitos, para que "0981 000 001" encuentre "0981000001"
    return dig.length >= 3 && soloDigitos(r.Telefono).indexOf(dig) >= 0;
  });
}

