const FORMS = {
  msgForm: { asunto: 'ASUNTO_HUESPED', mensaje: 'MENSAJE_HUESPED', wa: 'MENSAJE_WHATSAPP', auto: 'WA_ACTIVO', params: 'WA_PARAMS', defecto: 'MENSAJE_HUESPED' },
  recForm: { asunto: 'RECORDATORIO_ASUNTO', mensaje: 'RECORDATORIO_MENSAJE', wa: 'RECORDATORIO_WHATSAPP', auto: 'RECORDATORIO_WA_AUTO', params: 'WA_PARAMS_RECORDATORIO', defecto: 'RECORDATORIO_MENSAJE' }
};

function activeForm() {
  return S.ad.tab === 'recordatorios' ? 'recForm' : 'msgForm';
}

function recFormData() {
  const f = formData($('#recForm'));
  const estados = Object.keys(f).filter(k => k.startsWith('est_') && f[k]).map(k => k.slice(4));
  Object.keys(f).filter(k => k.startsWith('est_')).forEach(k => delete f[k]);
  f.RECORDATORIO_ESTADOS = estados.join(',');
  return f;
}

function msgForm() {
  const id = activeForm();
  if (!$('#' + id)) return S.ad.d.config;
  return Object.assign({}, S.ad.d.config, id === 'recForm' ? recFormData() : formData($('#' + id)));
}

function ejemploSerie() {
  const d = S.ad.d, hoy = d.hoy;
  const senaPct = Number(d.config.SENA_PCT || 0);
  let ci = D.add(hoy, 10);
  if (activeForm() === 'recForm') {
    const dias = String(msgForm().RECORDATORIO_DIAS || '').split(/[,;\s]+/).map(Number).filter(n => !isNaN(n) && n >= 0);
    ci = D.add(hoy, dias.length ? Math.max(...dias) : 3);
  }
  const c = d.cabanas[0] || {};
  const tar = tarifaPara(c, 2);
  return [{
    Codigo: 'AH-EJEMPLO', Cliente: 'María González', CabanaID: c.ID, CabanaNombre: c.Nombre || 'Cabaña',
    TipoNombre: 'Estadía estándar', TarifaNombre: tar ? tar.Nombre : '', Paquete: false,
    Huespedes: 2, CheckIn: ci, CheckOut: D.add(ci, 2), HoraLlegada: d.config.CHECKIN_HORA || '14:00',
    Total: 1000000, Sena: Math.round(1000000 * senaPct / 100), Estado: activeForm() === 'recForm' ? 'Confirmada' : (d.config.ESTADO_INICIAL || 'Pendiente')
  }];
}

function msgPreview() {
  const k = FORMS[activeForm()];
  const f = msgForm();
  const ej = tplVars(f, ejemploSerie(), f);
  const vars = Object.assign({}, ej, { detalle: '@@DETALLE@@' });
  const filas = [['Código', ej.codigo], ['Cabaña', ej.cabana], ['Tipo', ej.tipo]];
  if (ej.tarifa) filas.push(['Tarifa', ej.tarifa]);
  filas.push(['Fechas', ej.fechas], ['Huéspedes', ej.huespedes], ['Total', ej.total], ['Seña', ej.sena], ['Estado', ej.estado]);
  const tabla = `<div class="prev-table">${filas.map(([a, v]) => `<div><span>${a}</span><b>${esc(v)}</b></div>`).join('')}</div>`;
  const subject = fillTpl(f[k.asunto] || 'Tu reserva {codigo}', vars).replace(/\*/g, '');
  const body = txtHtml(fillTpl(f[k.mensaje], vars))
    .replace(/(https:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>')
    .replace('@@DETALLE@@', tabla);
  return `<div class="mail-subj"><span class="muted small">Asunto</span><b>${esc(subject)}</b></div><div class="mail-body">${body}</div>`;
}

function waPreview() {
  const k = FORMS[activeForm()];
  const f = msgForm();
  const txt = fillTpl(f[k.wa], tplVars(f, ejemploSerie(), f));
  return `<div class="wa-chat"><div class="wa-bubble">${txtHtml(txt)}</div></div>`;
}

function tplParamsPreview() {
  const k = FORMS[activeForm()];
  const f = msgForm();
  const vars = tplVars(f, ejemploSerie(), f);
  const claves = String(f[k.params] || '').split(',').map(x => x.trim()).filter(Boolean);
  const activo = String(f[k.auto] || 'NO').toUpperCase() === 'SI';
  if (!claves.length) return '<p class="muted small">Sin variables: la plantilla se envía tal como está aprobada.</p>';
  return `<p class="small ${activo ? 'ok' : 'muted'}" style="margin-bottom:8px">${activo ? 'Envío automático activo.' : 'Envío automático desactivado.'} Así se llenan los espacios de la plantilla:</p>
    <div class="prev-table">${claves.map((x, i) => {
      const ok = Object.prototype.hasOwnProperty.call(vars, x);
      const val = ok ? String(vars[x]).replace(/[\r\n\t]+/g, ' | ') : 'variable desconocida';
      return `<div><span>{{${i + 1}}} ${esc(x)}</span><b class="${ok ? '' : 'err'}" style="text-align:right">${esc(val.length > 80 ? val.slice(0, 80) + '…' : val)}</b></div>`;
    }).join('')}</div>`;
}

function refreshMsgPreviews() {
  if ($('#msgPrev')) $('#msgPrev').innerHTML = msgPreview();
  if ($('#waPrev')) $('#waPrev').innerHTML = waPreview();
  if ($('#tplPrev')) $('#tplPrev').innerHTML = tplParamsPreview();
}

